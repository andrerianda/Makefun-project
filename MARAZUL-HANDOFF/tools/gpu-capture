#!/bin/bash
# gpu-capture: run tools/capture.mjs (or tools/smoke-game.mjs) on the rented GPU machine with hardware WebGL.
# Usage, from the repository root, with the same arguments as the local tool:
#   /opt/marazul-tools/gpu-capture capture --size 960x540 --page "index.html?shot=x" --out /tmp/marazul/<area>/x.jpg
#   /opt/marazul-tools/gpu-capture smoke --out /tmp/marazul/<area>/smoke.jpg
# Output files must be under /tmp/marazul/ (they are brought back from the GPU machine).
# Exit code 75 means no GPU machine could be had: run the local tool instead.
set -o pipefail
tool="$1"; shift
case "$tool" in
  capture) script=tools/capture.mjs ;;
  smoke) script=tools/smoke-game.mjs ;;
  *) echo "usage: gpu-capture capture|smoke <arguments of the local tool>" >&2; exit 2 ;;
esac
args=""
for a in "$@"; do args="$args $(printf '%q' "$a")"; done
remote="export PATH=/opt/node/bin:\$PATH PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers NODE_PATH=/opt/node/lib/node_modules; \
flock /tmp/pw-setup.lock bash -c \"\$(echo $(base64 -w0 /opt/marazul-tools/pod-browser-setup.sh) | base64 -d)\" >/dev/null 2>&1; \
mkdir -p node_modules && ln -sfn /opt/node/lib/node_modules/playwright node_modules/playwright && ln -sfn /opt/node/lib/node_modules/playwright-core node_modules/playwright-core; \
sed -i \"s/'--use-angle=swiftshader',/'--use-angle=vulkan', '--enable-features=Vulkan',/; s/'--enable-unsafe-swiftshader',/'--ignore-gpu-blocklist',/\" tools/browser-page.mjs; \
node $script$args"
# Captures use their own GPU machine (marazul-shots) during busy shifts; comment out to share marazul-bake.
# Spread captures over both machines (odd process ids go to marazul-shots).
# (disabled between shifts) if [ -z "$MARAZUL_GPU_CFG" ] && [ $(( $$ % 2 )) -eq 1 ]; then export MARAZUL_GPU_CFG=/root/.config/marazul/gpu-worker-shots.json MARAZUL_POD_NAME=marazul-shots; fi
exec /opt/marazul-tools/gpu-run --sync game,tools --pull nothing_to_pull --timeout 900 -- bash -c "$remote"
